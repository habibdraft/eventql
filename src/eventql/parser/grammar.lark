start: expr

?expr: expr "&" expr   -> and_expr
     | expr "|" expr   -> or_expr
     | expr "==" expr  -> eq
     | expr "<" expr   -> lt
     | expr ">" expr   -> gt
     | func

?func: "C" "(" expr ")"        -> cumsum
     | "D" "(" expr ")"        -> diff
     | "S" "(" expr "," expr ")" -> shift
     | "BEFORE" "(" expr ")" -> before
     | "AFTER" "(" expr ")" -> after
     | "ENTER" "(" expr ")" -> enter
     | "EXIT" "(" expr ")" -> exit
     | "BETWEEN" "(" expr "," expr ")" -> between
     | atom

?atom: NAME
     | SIGNED_NUMBER
     | "(" expr ")"

%import common.CNAME -> NAME
%import common.SIGNED_NUMBER
%import common.WS
%ignore WS